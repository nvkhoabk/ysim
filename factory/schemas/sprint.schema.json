{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysim.vn/schemas/sprint.schema.json",
  "title": "YSF Sprint Definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "sprintCode",
    "sprintName",
    "baseline",
    "taskCount",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "sprintCode": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "sprintName": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "ysfVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "executionMode": {
      "enum": [
        "SEQUENTIAL"
      ]
    },
    "taskCount": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "order"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^s[0-9]{2}-t[0-9]{2}$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
